---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
import { getInstagramPosts } from '../data/instagram';
import instagramConfig from '../data/instagram.json';

interface Props {
  limit?: number;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  limit = 3,
  title = 'Novedades y talleres',
  subtitle = 'Mensajes semanales, talleres y todo lo que pasa en Verderapia.',
  class: className = '',
} = Astro.props;

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);

// Publicaciones de Instagram, que se muestran junto a las novedades del blog.
const instaPosts = await getInstagramPosts();
const instaUsername = instagramConfig.username;
const instaProfileUrl = instagramConfig.profile_url ?? '#';
---

<section class:list={['posts', className]} id="novedades" aria-labelledby="novedades-title">
  <div class="container">
    <header class="posts__head">
      <h2 id="novedades-title">{title}</h2>
      <p class="posts__subtitle">{subtitle}</p>
    </header>

    <div class="posts__grid">
      {posts.map((post) => <PostCard post={post} />)}

      {instaPosts.map((p) => (
        <a
          class="post-card post-card--insta"
          href={p.href || instaProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={p.alt || `Publicación de Instagram de @${instaUsername}`}
        >
          <div class="post-card__media">
            <img src={p.image} alt={p.alt ?? ''} loading="lazy" decoding="async" />
          </div>
          <div class="post-card__body">
            <span class="post-card__date">Instagram</span>
            <h3 class="post-card__title">@{instaUsername}</h3>
            {p.text && <p class="post-card__desc">{p.text}</p>}
            <span class="post-card__more">Ver en Instagram →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="posts__cta">
      <a class="btn" href="/posts/">Ver todas las novedades</a>
    </div>
  </div>
</section>

<style>
  /* Las tarjetas de Instagram usan imagen cuadrada, como la rejilla original. */
  .post-card--insta .post-card__media img {
    aspect-ratio: 1 / 1;
  }
</style>
