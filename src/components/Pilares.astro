---
import { site } from '../data/site';

interface Props {
  variant?: 'rows' | 'cards';
}

const { variant = 'rows' } = Astro.props;
const pilares = site.pilares;
---

{variant === 'rows' ? (
  <div class="pilares pilares--rows">
    {pilares.map((p, i) => (
      <section class:list={['pilar-row', 'section', i % 2 === 1 && 'pilar-row--reverse']} id={p.id} aria-labelledby={`pilar-${p.id}`}>
        <div class="container pilar-row__grid">
          <div class="pilar-row__media" data-reveal>
            <img src={p.imagen} alt={`${p.titulo} — Verderapia`} loading="lazy" decoding="async" />
            <span class="pilar-row__tag">{p.eyebrow}</span>
          </div>
          <div class="pilar-row__text" data-reveal style="--reveal-delay:120ms">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} — {p.subtitulo}</p>
            <h2 id={`pilar-${p.id}`}>{p.titulo}</h2>
            <p class="lead">{p.descripcion}</p>
            <ul class="pilar-row__items">
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
            <a class="btn btn--ghost" href="#contacto">Consultar por {p.titulo.toLowerCase()}</a>
          </div>
        </div>
      </section>
    ))}
  </div>
) : (
  <section class="pilares pilares--cards section">
    <div class="container">
      <header class="pilares__head" data-reveal>
        <p class="eyebrow">Tres caminos, un mismo lugar</p>
        <h2>Verde, Arte y Terapia</h2>
      </header>
      <div class="pilares__grid">
        {pilares.map((p, i) => (
          <article class="pilar-card" id={p.id} data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <div class="pilar-card__media">
              <img src={p.imagen} alt={`${p.titulo} — Verderapia`} loading="lazy" decoding="async" />
              <span class="pilar-card__num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="pilar-card__body">
              <p class="eyebrow">{p.eyebrow}</p>
              <h3>{p.titulo}</h3>
              <p>{p.descripcion}</p>
              <ul class="pilar-card__items">
                {p.items.slice(0, 5).map((it) => <li>{it}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* ---- Rows ---- */
  .pilar-row__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .pilar-row--reverse .pilar-row__media {
    order: 2;
  }
  .pilar-row__media {
    position: relative;
    aspect-ratio: 5 / 4;
  }
  .pilar-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .pilar-row__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5em 1em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .pilar-row__text h2 {
    margin: 0.7rem 0 1rem;
  }
  .pilar-row__items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.4rem;
    margin: 1.5rem 0;
  }
  .pilar-row__items li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .pilar-row__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--brand);
  }

  /* ---- Cards ---- */
  .pilares__head {
    max-width: 620px;
    margin-bottom: clamp(2rem, 5vw, 3.4rem);
  }
  .pilares__head h2 {
    margin-top: 0.7rem;
  }
  .pilares__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 3vw, 2rem);
  }
  .pilar-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .pilar-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .pilar-card__media {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .pilar-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pilar-card__num {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }
  .pilar-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.6vw, 1.9rem);
  }
  .pilar-card__body h3 {
    font-size: 1.5rem;
  }
  .pilar-card__body p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .pilar-card__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.4rem;
  }
  .pilar-card__items li {
    font-size: 0.78rem;
    padding: 0.35em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .pilar-row__grid {
      grid-template-columns: 1fr;
    }
    .pilar-row--reverse .pilar-row__media {
      order: 0;
    }
    .pilares__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
