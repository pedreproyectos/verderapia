---
import { site } from '../data/site';
import { galeria } from '../data/images';

interface Props {
  variant?: 'split' | 'centered';
}

const { variant = 'split' } = Astro.props;
const img = galeria.retratos[0];
const img2 = galeria.verde[1];
---

<section class:list={['historia', `historia--${variant}`, 'section']} id="historia" aria-labelledby="historia-title">
  <div class="container historia__grid">
    <div class="historia__text" data-reveal>
      <p class="eyebrow">Nuestra historia</p>
      <h2 id="historia-title">{site.heroTitulo}</h2>
      <p class="lead">{site.historiaLarga}</p>
      <ul class="historia__elementos">
        {site.elementos.map((el, i) => (
          <li style={`--i:${i}`}>
            <span class="historia__dot"></span>
            {el}
          </li>
        ))}
      </ul>
      <p class="muted">{site.giftCard.texto}</p>
    </div>

    <div class="historia__media" data-reveal style="--reveal-delay:120ms">
      <img class="historia__img historia__img--main" src={img} alt="Verderapia" loading="lazy" decoding="async" />
      <img class="historia__img historia__img--alt" src={img2} alt="Parcela sustentable Verderapia" loading="lazy" decoding="async" />
      <span class="historia__badge">agua · tierra · luz · aire</span>
    </div>
  </div>
</section>

<style>
  .historia__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .historia__text h2 {
    margin: 0.8rem 0 1.3rem;
  }
  .historia__elementos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0;
  }
  .historia__elementos li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5em 1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--surface);
  }
  .historia__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
  }
  .historia__elementos li:nth-child(2) .historia__dot {
    background: var(--brand);
  }
  .historia__elementos li:nth-child(3) .historia__dot {
    background: var(--accent-2);
  }
  .historia__elementos li:nth-child(4) .historia__dot {
    background: var(--brand-2);
  }
  .historia__media {
    position: relative;
    aspect-ratio: 4 / 4.4;
  }
  .historia__img {
    position: absolute;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .historia__img--main {
    inset: 0 18% 12% 0;
    width: 82%;
    height: 88%;
  }
  .historia__img--alt {
    right: 0;
    bottom: 0;
    width: 52%;
    height: 46%;
    border: 6px solid var(--bg);
  }
  .historia__badge {
    position: absolute;
    left: 0;
    bottom: 4%;
    padding: 0.6em 1.1em;
    border-radius: 999px;
    background: var(--brand);
    color: var(--btn-ink);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .historia--centered .historia__grid {
    grid-template-columns: 1fr;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .historia--centered .historia__elementos {
    justify-content: center;
  }
  .historia--centered .historia__media {
    margin-inline: auto;
    max-width: 560px;
    width: 100%;
  }
  @media (max-width: 820px) {
    .historia__grid {
      grid-template-columns: 1fr;
    }
    .historia__media {
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
