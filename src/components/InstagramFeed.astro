---
import { site } from '../data/site';
import { getInstagramPosts, type InstaPost } from '../data/instagram';
import instagramConfig from '../data/instagram.json';

interface Props {
  class?: string;
  /** Publicaciones a mostrar. Por defecto se obtienen de la API de Instagram. */
  posts?: InstaPost[];
}

const { class: className = '', posts } = Astro.props;

const username = instagramConfig.username || site.contacto.instagram;
const profileUrl = instagramConfig.profile_url || site.contacto.instagramUrl;

// Publicaciones de Instagram: si no llegan por prop, se obtienen de la API.
const items: InstaPost[] = posts ?? (await getInstagramPosts());
---

<section
  class:list={['instagram', 'section', className]}
  id="instagram"
  aria-label={`Publicaciones de Instagram de @${username}`}
>
  <div class="container">
    {items.length > 0 ? (
      <div class="instagram__grid">
        {items.map((p) => (
          <a
            class="instagram__card"
            href={p.href || profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={p.alt || `Publicación de Instagram de @${username}`}
          >
            <div class="instagram__media">
              <img src={p.image} alt={p.alt ?? ''} loading="lazy" decoding="async" />
            </div>
            <div class="instagram__caption">
              <p class="instagram__text">{p.text ?? ''}</p>
              <span class="instagram__link">Ver publicación →</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="instagram__empty muted">
        Aún no hay publicaciones. Agrégalas en <code>src/data/instagram.json</code>.
      </p>
    )}
  </div>
</section>

<style>
  .instagram__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  .instagram__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .instagram__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
  }
  .instagram__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .instagram__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .instagram__card:hover .instagram__media img {
    transform: scale(1.05);
  }
  .instagram__caption {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1rem, 2vw, 1.3rem);
  }
  .instagram__text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .instagram__link {
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--brand);
  }
  .instagram__empty {
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
  @media (max-width: 640px) {
    .instagram__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
