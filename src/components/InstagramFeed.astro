---
import { site } from '../data/site';
import { getInstagramPosts, type InstaPost } from '../data/instagram';
import instagramConfig from '../data/instagram.json';
import highlights from '../data/highlights.json';

interface Props {
  class?: string;
  /** Publicaciones a mostrar. Por defecto se obtienen de la API de Instagram. */
  posts?: InstaPost[];
}

const { class: className = '', posts } = Astro.props;

const username = instagramConfig.username || site.contacto.instagram;
const profileUrl = instagramConfig.profile_url || site.contacto.instagramUrl;

// Publicaciones de Instagram: si no llegan por prop, se obtienen de la API.
const items: InstaPost[] = posts ?? (await getInstagramPosts());
---

<section
  class:list={['instagram', 'section', className]}
  id="novedades"
  aria-labelledby="novedades-title"
  data-instagram-feed
  data-username={username}
  data-profile-url={profileUrl}
>
  <div class="container">
    <header class="instagram__head" data-reveal>
      <p class="eyebrow">Instagram</p>
      <h2 id="novedades-title">Novedades</h2>
    </header>

    <div class="instagram__grid" data-instagram-grid>
      {items.map((p) => (
        <a
          class="instagram__card"
          href={p.href || profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={p.alt || `Publicación de Instagram de @${username}`}
        >
          <div class="instagram__media">
            <img src={p.image} alt={p.alt ?? ''} loading="lazy" decoding="async" />
          </div>
          <div class="instagram__caption">
            {p.text && <p class="instagram__text">{p.text}</p>}
            <span class="instagram__link">Ver publicación →</span>
          </div>
        </a>
      ))}
    </div>
    {items.length === 0 && (
      <p class="instagram__empty muted" data-instagram-empty>
        Aún no hay publicaciones. Agrégalas en <code>src/data/instagram.json</code>.
      </p>
    )}

    {highlights.length > 0 && (
      <div class="instagram__highlights" data-reveal>
        <h3>Historias destacadas</h3>
        <ul class="highlights">
          {highlights.map((h) => (
            <li>
              <a href={h.href} target="_blank" rel="noopener noreferrer">
                <span class="highlights__ring">
                  <img src={h.image} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="highlights__title">{h.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="instagram__embed" data-reveal>
      <h3>Publicación destacada</h3>
      <blockquote
        class="instagram-media"
        data-instgrm-permalink="https://www.instagram.com/p/Df9v8e2ylg7/?utm_source=ig_embed&amp;utm_campaign=loading"
        data-instgrm-version="14"
        style="background:#FFF;border:0;border-radius:3px;box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15);margin:1px auto;max-width:540px;min-width:326px;padding:0;width:calc(100% - 2px);"
      >
        <div style="padding:16px;">
          <a
            href="https://www.instagram.com/p/Df9v8e2ylg7/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver esta publicación en Instagram
          </a>
        </div>
      </blockquote>
      <script async src="https://www.instagram.com/embed.js" is:inline></script>
    </div>
  </div>
</section>

<script>
  type FeedPost = {
    image: string;
    text?: string;
    href?: string;
    alt?: string;
  };

  const section = document.querySelector<HTMLElement>('[data-instagram-feed]');
  const grid = section?.querySelector<HTMLElement>('[data-instagram-grid]');
  const username = section?.dataset.username ?? 'verderapia';
  const profileUrl = section?.dataset.profileUrl ?? '#';

  function renderCard(post: FeedPost): HTMLAnchorElement {
    const card = document.createElement('a');
    card.className = 'instagram__card';
    card.href = post.href || profileUrl;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';
    card.setAttribute(
      'aria-label',
      post.alt || `Publicación de Instagram de @${username}`,
    );

    const media = document.createElement('div');
    media.className = 'instagram__media';

    const img = document.createElement('img');
    img.src = post.image;
    img.alt = post.alt ?? '';
    img.loading = 'lazy';
    img.decoding = 'async';
    media.append(img);

    const caption = document.createElement('div');
    caption.className = 'instagram__caption';

    if (post.text) {
      const text = document.createElement('p');
      text.className = 'instagram__text';
      text.textContent = post.text;
      caption.append(text);
    }

    const link = document.createElement('span');
    link.className = 'instagram__link';
    link.textContent = 'Ver publicación →';
    caption.append(link);

    card.append(media, caption);
    return card;
  }

  // Actualiza las tarjetas con el feed en vivo, sin depender de un despliegue.
  if (section && grid) {
    void fetch('/api/instagram', { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { posts?: FeedPost[] } | null) => {
        const posts = (data?.posts ?? []).filter((post) => post.image);
        if (posts.length === 0) return;

        const firstCard = grid.querySelector('.instagram__card');
        const firstHref = firstCard?.getAttribute('href') ?? '';
        if (firstHref === (posts[0].href || profileUrl)) return;

        grid.replaceChildren(...posts.map(renderCard));
        section.querySelector('[data-instagram-empty]')?.remove();
      })
      .catch(() => {
        // Si falla la actualización, se mantiene el HTML generado en el build.
      });
  }
</script>

<style>
  .instagram__head {
    max-width: 640px;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .instagram__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  .instagram__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .instagram__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
  }
  .instagram__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .instagram__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .instagram__card:hover .instagram__media img {
    transform: scale(1.05);
  }
  .instagram__caption {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1rem, 2vw, 1.3rem);
  }
  .instagram__text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .instagram__link {
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--brand);
  }
  .instagram__empty {
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
  .instagram__highlights {
    margin-top: clamp(2rem, 4vw, 2.8rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .instagram__highlights h3 {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem 1.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 92px;
    text-align: center;
  }
  .highlights__ring {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    padding: 3px;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg,
      var(--brand),
      #9bb07a,
      #d3b25a,
      var(--brand)
    );
    transition: transform 0.3s ease;
  }
  .highlights a:hover .highlights__ring {
    transform: scale(1.05);
  }
  .highlights__ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--bg);
  }
  .highlights__title {
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink-soft);
  }
  .highlights a:hover .highlights__title {
    color: var(--brand);
  }
  .instagram__embed {
    margin-top: clamp(2rem, 4vw, 2.8rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .instagram__embed h3 {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }
  .instagram__embed .instagram-media {
    text-align: left;
  }
  @media (max-width: 640px) {
    .highlights {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.4rem;
      scroll-snap-type: x proximity;
    }
    .highlights li {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 640px) {
    .instagram__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
