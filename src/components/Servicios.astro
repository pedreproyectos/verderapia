---
import { getServicios } from '../data/servicios';

const servicios = await getServicios();

const iconos: Record<string, string> = {
  tarot:
    '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="m12 8 1.2 2.6 2.8.4-2 2 .5 2.8-2.5-1.4-2.5 1.4.5-2.8-2-2 2.8-.4Z"/>',
  flor:
    '<circle cx="12" cy="12" r="3"/><path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"/><path d="M12 7.5V9"/><path d="M7.5 12H9"/><path d="M16.5 12H15"/><path d="M12 16.5V15"/><path d="m8 8 1.88 1.88"/><path d="M14.12 9.88 16 8"/><path d="m8 16 1.88-1.88"/><path d="M14.12 14.12 16 16"/>',
  brote:
    '<path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3"/><path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4"/><path d="M5 21h14"/>',
  cuerpo:
    '<path d="M11 14h2a2 2 0 0 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="m14.45 13.39 5.05-4.694C20.196 8 21 6.85 21 5.75a2.75 2.75 0 0 0-4.797-1.837.276.276 0 0 1-.406 0A2.75 2.75 0 0 0 11 5.75c0 1.2.802 2.248 1.5 2.946L16 11.95"/><path d="m2 15 6 6"/><path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a1 1 0 0 0-2.75-2.91"/>',
  sistema:
    '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  default:
    '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>',
};

const chevron = '<path d="m9 18 6-6-6-6"/>';
---

{servicios.length > 0 && (
  <section class="servicios section" id="servicios" aria-labelledby="servicios-title">
    <div class="container">
      <div class="servicios__media" data-reveal>
        <img
          src="/images/verderapia/servicios/servicios-main.webp"
          alt="Mesa con libros de yoga, meditación y autocuidado, cartas de tarot, aceites esenciales y cristales"
          loading="lazy"
          decoding="async"
        />
      </div>

      <header class="servicios__head" data-reveal>
        <p class="eyebrow">Talleres y Servicios</p>
        <h2 id="servicios-title">Talleres: Autoconocimiento y Autocuidado</h2>
        <p class="servicios__lead">
          Espacio de aprendizaje para explorar tus emociones, comprender tus
          procesos y cultivar el bienestar cotidiano.
        </p>
      </header>

      <div class="servicios__list">
        {servicios.map((s) => (
          <details
            class:list={['servicio', `servicio--${s.tono ?? 'amarillo'}`]}
            data-reveal
          >
            <summary class="servicio__summary">
              <span class="servicio__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={iconos[s.icono ?? 'default'] ?? iconos.default}
                />
              </span>

              <span class="servicio__heading">
                <span class="servicio__title-row">
                  <span class="servicio__title">{s.nombre}</span>
                  <svg
                    class="servicio__chevron"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={chevron}
                  />
                </span>

                {s.subtitulo && (
                  <span class="servicio__subtitle">{s.subtitulo}</span>
                )}
                {s.descripcion && (
                  <span class="servicio__desc">{s.descripcion}</span>
                )}
                {s.detalles.length > 0 && (
                  <span class="servicio__tags">{s.detalles.join(' · ')}</span>
                )}
              </span>
            </summary>

            <div class="servicio__body">
              <div class="servicio__body-inner">
                {s.items.length > 0 && (
                  <div class="servicio__block">
                    <h4>Servicios</h4>
                    <ul class="servicio__items">
                      {s.items.map((item) => (
                        <li>
                          <div class="servicio__item-head">
                            <span class="servicio__item-name">{item.nombre}</span>
                            <span class="servicio__item-meta">
                              {item.duraciones.length > 0 && (
                                <span class="servicio__item-dur">
                                  {item.duraciones.join(' · ')}
                                </span>
                              )}
                              {item.precio && (
                                <strong class="servicio__item-precio">
                                  {item.precio}
                                </strong>
                              )}
                            </span>
                          </div>
                          {item.descripcion &&
                            item.descripcion
                              .split(/\n{2,}/)
                              .map((p) => p.trim())
                              .filter(Boolean)
                              .map((p) => <p>{p}</p>)}
                          {item.nota && (
                            <p class="servicio__item-nota">{item.nota}</p>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {s.horarios.length > 0 && (
                  <div class="servicio__block">
                    <h4>Horarios</h4>
                    <ul class="servicio__horarios">
                      {s.horarios.map((d) => (
                        <li>
                          <span class="servicio__dia">{d.dia}</span>
                          <span class="servicio__clases">
                            {d.clases.map((c) => (
                              <span class="servicio__clase">
                                <em>{c.hora}</em> {c.nombre}
                              </span>
                            ))}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {s.precios.length > 0 && (
                  <div class="servicio__block">
                    <h4>Precios</h4>
                    <ul class="servicio__precios">
                      {s.precios.map((p) => (
                        <li>
                          <span>
                            {p.nombre}
                            {p.detalle && <em> · {p.detalle}</em>}
                          </span>
                          <strong>{p.valor}</strong>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {s.nota && <p class="servicio__nota">{s.nota}</p>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .servicios__media {
    margin-bottom: clamp(1.8rem, 4vw, 2.8rem);
  }
  .servicios__media img {
    display: block;
    width: 100%;
    aspect-ratio: 1520 / 585;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .servicios__head {
    max-width: 760px;
    margin: 0 auto clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .servicios__head h2 {
    margin-top: 0.7rem;
  }
  .servicios__lead {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
  }

  .servicios__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.25rem);
    align-items: start;
  }

  .servicio {
    --tone-bg: #fbf3d9;
    --tone-accent: #96790f;
    --tone-line: color-mix(in srgb, var(--tone-accent) 22%, transparent);
    border: 1px solid var(--tone-line);
    border-radius: var(--radius);
    background: var(--tone-bg);
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .servicio--amarillo {
    --tone-bg: #fbf3d9;
    --tone-accent: #96790f;
  }
  .servicio--lavanda {
    --tone-bg: #ede4f7;
    --tone-accent: #7a4fa3;
  }
  .servicio--rosa {
    --tone-bg: #f7e2ee;
    --tone-accent: #a34a7c;
  }
  .servicio--menta {
    --tone-bg: #e4f1e7;
    --tone-accent: #3f7a55;
  }
  .servicio--verde {
    --tone-bg: #e8f1e3;
    --tone-accent: #4f7a3a;
  }
  .servicio[open] {
    box-shadow: var(--shadow);
  }

  .servicio__summary {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.8rem, 1.8vw, 1.15rem);
    padding: clamp(1.05rem, 2vw, 1.45rem);
    cursor: pointer;
    list-style: none;
  }
  .servicio__summary::-webkit-details-marker {
    display: none;
  }
  .servicio__summary:focus-visible {
    outline: 2px solid var(--tone-accent);
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  .servicio__icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: clamp(2.8rem, 4vw, 3.4rem);
    height: clamp(2.8rem, 4vw, 3.4rem);
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-accent) 10%, white);
    color: var(--tone-accent);
  }
  .servicio__icon svg {
    width: 55%;
    height: 55%;
  }

  .servicio__heading {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.18rem;
    padding-top: 0.1rem;
  }
  .servicio__title-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .servicio__title {
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.8vw, 1.32rem);
    line-height: 1.15;
    color: var(--ink);
  }
  .servicio__chevron {
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--tone-accent);
    transition: transform 0.3s ease;
  }
  .servicio[open] .servicio__chevron {
    transform: rotate(90deg);
  }
  .servicio__subtitle {
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--tone-accent);
  }
  .servicio__desc {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .servicio__tags {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .servicio__body {
    background: color-mix(in srgb, var(--surface) 82%, var(--tone-bg));
    animation: servicioOpen 0.28s ease;
  }
  .servicio__body-inner {
    display: grid;
    gap: 1.1rem;
    padding: 0 clamp(1.05rem, 2vw, 1.45rem) clamp(1.2rem, 2vw, 1.5rem);
    border-top: 1px solid var(--tone-line);
    padding-top: 1rem;
  }
  @keyframes servicioOpen {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
  }

  .servicio__block h4 {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }
  .servicio__items {
    display: grid;
    gap: 0.85rem;
  }
  .servicio__items li {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--tone-line);
  }
  .servicio__items li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .servicio__item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 0.8rem;
  }
  .servicio__item-name {
    font-weight: 800;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .servicio__item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }
  .servicio__item-precio {
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--tone-accent);
    white-space: nowrap;
  }
  .servicio__item-dur {
    flex: 0 0 auto;
    padding: 0.15em 0.6em;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--tone-accent);
    background: color-mix(in srgb, var(--tone-accent) 10%, white);
    border-radius: 999px;
    white-space: nowrap;
  }
  .servicio__items p {
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .servicio__item-nota {
    font-style: italic;
    color: var(--tone-accent) !important;
  }
  .servicio__horarios {
    border-top: 1px solid var(--tone-line);
  }
  .servicio__horarios li {
    display: grid;
    grid-template-columns: minmax(5.5rem, 7rem) 1fr;
    gap: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--tone-line);
  }
  .servicio__dia {
    font-weight: 700;
    color: var(--tone-accent);
  }
  .servicio__clases {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .servicio__clase em {
    font-style: normal;
    font-weight: 700;
    color: var(--tone-accent);
    margin-right: 0.3rem;
  }
  .servicio__precios li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--tone-line);
  }
  .servicio__precios li:last-child {
    border-bottom: 0;
  }
  .servicio__precios em {
    font-style: normal;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .servicio__precios strong {
    font-family: var(--font-display);
    color: var(--tone-accent);
    font-size: 1.12rem;
    white-space: nowrap;
  }
  .servicio__nota {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .servicios__media img {
      aspect-ratio: 4 / 3;
    }
    .servicios__list {
      grid-template-columns: 1fr;
    }
  }
</style>
