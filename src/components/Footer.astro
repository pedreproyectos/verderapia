---
import { site } from '../data/site';

const year = new Date().getFullYear();
const c = site.contacto;
---

<footer class="footer" id="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <svg class="footer__logo" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 52c0-13 6-21 19-25-2 15-9 22-19 25Z" fill="var(--brand-2)"/>
        <path d="M32 52C19 48 12 40 10 25c13 4 20 13 22 27Z" fill="var(--accent)"/>
        <path d="M32 52V33" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/>
      </svg>
      <div>
        <strong>{site.nombre}</strong>
        <p>{site.tagline}.</p>
      </div>
    </div>

    <nav class="footer__links" aria-label="Enlaces del sitio">
      <a href="#verde">Verde</a>
      <a href="#arte">Arte</a>
      <a href="#terapia">Terapia</a>
      <a href="#terapias">Terapias</a>
      <a href="#yoga">Yoga</a>
      <a href="#novedades">Novedades</a>
      <a href="#instagram">Instagram</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="footer__social">
      <a href={c.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 1.8a3.1 3.1 0 1 1 0 6.2 3.1 3.1 0 0 1 0-6.2Zm5.2-2.4a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/></svg>
      </a>
      <a href={c.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6c-.3 0-1.3-.1-2.45-.1-2.4 0-4.05 1.45-4.05 4.15v2.25H7.5V14h2.75v8h3.25Z"/></svg>
      </a>
      <a href={c.whatsappLink} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 0 1 6.9 12.6l-.3.5.8 2.9-3-.8-.5.3A8.2 8.2 0 1 1 12 3.8Zm-3 4c-.2 0-.5.1-.7.4-.3.3-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.2-.1-1-.4-1.8-1.1-.7-.6-1.1-1.3-1.2-1.5-.1-.2 0-.3.1-.4l.4-.4c.1-.2.1-.3.2-.5 0-.2 0-.3-.1-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5Z"/></svg>
      </a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.nombre}. Todos los derechos reservados.</p>
    <p class="footer__meta">
      {c.direccion} ·
      <a href="/admin/">Admin de posts</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    border-top: 1px solid var(--line);
    background: var(--bg-2);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 2fr auto;
    gap: 2rem;
    align-items: start;
    padding-bottom: 2.4rem;
  }
  .footer__brand {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .footer__logo {
    width: 40px;
    height: 40px;
    flex: none;
    color: var(--ink);
  }
  .footer__brand strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .footer__brand p {
    color: var(--muted);
    font-size: 0.88rem;
    max-width: 32ch;
    margin-top: 0.3rem;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .footer__links a {
    opacity: 0.85;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .footer__links a:hover {
    opacity: 1;
    color: var(--brand);
  }
  .footer__social {
    display: flex;
    gap: 0.6rem;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .footer__social a:hover {
    transform: translateY(-3px);
    background: var(--brand);
    color: var(--btn-ink);
  }
  .footer__social svg {
    width: 20px;
    height: 20px;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .footer__meta a {
    color: var(--brand);
    font-weight: 600;
  }
  @media (max-width: 820px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
