---
import { site } from '../data/site';
import { galeria } from '../data/images';

const yoga = site.yoga;
const img = galeria.terapia[2];
---

<section class="yoga section" id="yoga" aria-labelledby="yoga-title">
  <div class="container yoga__grid">
    <div class="yoga__intro" data-reveal>
      <p class="eyebrow">Yoga</p>
      <h2 id="yoga-title">{yoga.nombre}</h2>
      <p class="lead">{yoga.descripcion}</p>
      <div class="yoga__media">
        <img src={img} alt="Clases de yoga en Verderapia" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="yoga__panel" data-reveal style="--reveal-delay:120ms">
      <div class="yoga__block">
        <h3>Horarios</h3>
        <ul class="yoga__horarios">
          {yoga.horarios.map((d) => (
            <li>
              <span class="yoga__dia">{d.dia}</span>
              <span class="yoga__clases">
                {d.clases.map((c) => (
                  <span class="yoga__clase">
                    <em>{c.hora}</em> {c.nombre}
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="yoga__block">
        <h3>Precios</h3>
        <ul class="yoga__precios">
          {yoga.precios.map((p) => (
            <li>
              <span>
                {p.nombre}
                {p.detalle && <em> · {p.detalle}</em>}
              </span>
              <strong>{p.valor}</strong>
            </li>
          ))}
        </ul>
        <p class="yoga__nota muted">{yoga.nota}</p>
      </div>

      <a class="btn" href={site.contacto.whatsappLink} target="_blank" rel="noopener noreferrer">Reservar una clase</a>
    </div>
  </div>
</section>

<style>
  .yoga__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .yoga__intro h2 {
    margin: 0.7rem 0 1rem;
  }
  .yoga__media {
    margin-top: 1.8rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .yoga__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .yoga__panel {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    padding: clamp(1.6rem, 3.4vw, 2.6rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .yoga__block h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .yoga__horarios li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .yoga__horarios li:last-child {
    border-bottom: 0;
  }
  .yoga__dia {
    font-weight: 700;
    color: var(--brand);
  }
  .yoga__clases {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .yoga__clase em {
    font-style: normal;
    font-weight: 700;
    color: var(--accent-2);
    margin-right: 0.35rem;
  }
  .yoga__precios li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
  }
  .yoga__precios em {
    font-style: normal;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .yoga__precios strong {
    font-family: var(--font-display);
    color: var(--brand);
    font-size: 1.15rem;
  }
  .yoga__nota {
    margin-top: 0.8rem;
    font-size: 0.82rem;
  }
  @media (max-width: 860px) {
    .yoga__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
