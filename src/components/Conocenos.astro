---
import { getVideos, vimeoEmbedUrl } from '../data/videos';

// Los videos se cargan desde Keystatic (/keystatic → Videos).
// Mientras no haya ninguno, la sección se muestra con un mensaje breve.
const videos = await getVideos();
---

<section class="conocenos section" id="conocenos" aria-labelledby="conocenos-title">
  <div class="container">
    <header class="conocenos__head" data-reveal>
      <p class="eyebrow">Videos</p>
      <h2 id="conocenos-title">Conócenos</h2>
    </header>

    {videos.length > 0 ? (
      <div
        class:list={[
          'conocenos__grid',
          videos.length === 1 && 'conocenos__grid--single',
        ]}
      >
        {videos.map((video, i) => (
          <figure
            class="conocenos__item"
            data-reveal
            style={`--reveal-delay:${Math.min(i, 4) * 90}ms`}
          >
            <div class="conocenos__frame">
              <button
                class="conocenos__play"
                type="button"
                data-vimeo-src={vimeoEmbedUrl(video)}
                data-vimeo-title={`${video.titulo} — video de Verderapia`}
                aria-label={`Reproducir ${video.titulo}`}
              >
                {video.thumbnail ? (
                  <img src={video.thumbnail} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="conocenos__fallback" aria-hidden="true"></span>
                )}
                <span class="conocenos__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
              <noscript>
                <iframe
                  src={vimeoEmbedUrl(video)}
                  title={`${video.titulo} — video de Verderapia`}
                  loading="lazy"
                  allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              </noscript>
            </div>
            <figcaption class="conocenos__caption">
              <h3>{video.titulo}</h3>
              {video.descripcion && <p>{video.descripcion}</p>}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="conocenos__empty muted" data-reveal>
        Pronto compartiremos aquí videos para que nos conozcas.
      </p>
    )}
  </div>
</section>

<style>
  .conocenos__head {
    max-width: 640px;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .conocenos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
  }
  .conocenos__grid--single {
    grid-template-columns: 1fr;
    max-width: 920px;
  }
  .conocenos__item {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .conocenos__frame {
    --conocenos-bg: color-mix(in srgb, var(--brand) 12%, #fff);
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--conocenos-bg);
  }
  .conocenos__play {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--conocenos-bg);
    cursor: pointer;
    overflow: hidden;
  }
  .conocenos__play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.3s ease;
  }
  .conocenos__play:hover img {
    transform: scale(1.03);
  }
  .conocenos__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--brand) 22%, #fff), transparent 60%),
      var(--conocenos-bg);
  }
  .conocenos__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin: auto;
    border-radius: 50%;
    color: var(--brand);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.45);
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .conocenos__play:hover .conocenos__icon {
    transform: scale(1.08);
    background: #fff;
  }
  .conocenos__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--conocenos-bg);
  }
  .conocenos__caption {
    padding: clamp(1rem, 2.4vw, 1.5rem);
  }
  .conocenos__caption h3 {
    font-size: 1.15rem;
  }
  .conocenos__caption p {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .conocenos__empty {
    max-width: 52ch;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  @media (max-width: 760px) {
    .conocenos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // El reproductor de Vimeo se carga recién al hacer clic: así la sección se ve
  // en verde claro (miniatura + botón) y no con el fondo negro del player.
  document.querySelectorAll<HTMLButtonElement>('[data-vimeo-src]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const src = boton.dataset.vimeoSrc;
      const title = boton.dataset.vimeoTitle ?? '';
      if (!src) return;

      const iframe = document.createElement('iframe');
      const separador = src.includes('?') ? '&' : '?';
      iframe.src = `${src}${separador}autoplay=1`;
      iframe.title = title;
      iframe.allow =
        'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      boton.replaceWith(iframe);
    });
  });
</script>
