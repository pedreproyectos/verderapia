---
import Base from '../layouts/Base.astro';
import { galeria } from '../data/images';
import { site } from '../data/site';

const temas = [
  {
    id: 1,
    slug: '/tema1/',
    nombre: 'Tema 1 · Raíces',
    resumen:
      'Cálido y botánico. Hero a pantalla completa con slider Ken Burns, secciones orgánicas y tarjetas suaves.',
    swatches: ['#2f5d3a', '#6f9b5f', '#c2703d', '#f7f2e8'],
    imagen: galeria.hero[0],
    rasgos: ['Hero full-screen', 'Slider fundido + zoom', 'Menú de terapias en lista', 'Serif Fraunces'],
  },
  {
    id: 2,
    slug: '/tema2/',
    nombre: 'Tema 2 · Editorial',
    resumen:
      'Minimal y luminoso. Hero partido con slider deslizante, tipografía grande y retícula tipo revista.',
    swatches: ['#141414', '#7f9070', '#d8c3a5', '#ffffff'],
    imagen: galeria.hero[1],
    rasgos: ['Hero partido', 'Slider deslizante', 'Terapias en acordeón', 'Esquinas rectas'],
  },
  {
    id: 3,
    slug: '/tema3/',
    nombre: 'Tema 3 · Noche verde',
    resumen:
      'Oscuro y moderno. Hero con glassmorphism, textos con gradiente, brillos y tarjetas de vidrio.',
    swatches: ['#0b120f', '#35e0a1', '#d9ff6b', '#101b15'],
    imagen: galeria.hero[2],
    rasgos: ['Hero oscuro + glow', 'Slider apilado', 'Terapias en tarjetas glass', 'Acentos neón'],
  },
];
---

<Base tema={1} title="Verderapia · 3 propuestas de one-page" description="Tres alternativas de diseño para el sitio one-page de Verderapia.">
  <main class="pick">
    <div class="container">
      <header class="pick__head">
        <p class="eyebrow">Verderapia · Propuestas de diseño</p>
        <h1>Tres alternativas de one-page</h1>
        <p class="lead">
          Un mismo sitio —{site.tagline}— con tres direcciones visuales. Las tres incluyen
          slider, secciones, admin de posts y feed de Instagram.
        </p>
      </header>

      <div class="pick__grid">
        {temas.map((t) => (
          <article class="pick__card">
            <a class="pick__media" href={t.slug} aria-label={`Ver ${t.nombre}`}>
              <img src={t.imagen} alt={t.nombre} loading="lazy" decoding="async" />
              <span class="pick__num">{String(t.id).padStart(2, '0')}</span>
            </a>
            <div class="pick__body">
              <h2>{t.nombre}</h2>
              <p>{t.resumen}</p>
              <ul class="pick__rasgos">
                {t.rasgos.map((r) => <li>{r}</li>)}
              </ul>
              <div class="pick__swatches">
                {t.swatches.map((c) => <span style={`background:${c}`}></span>)}
              </div>
              <a class="btn" href={t.slug}>Ver propuesta →</a>
            </div>
          </article>
        ))}
      </div>

      <div class="pick__extras">
        <a class="pick__extra" href="/posts/">
          <strong>Admin de posts</strong>
          <span>Panel de contenidos en /admin (Decap/Sveltia) y blog en /posts.</span>
        </a>
        <a class="pick__extra" href="/admin/">
          <strong>Panel /admin</strong>
          <span>Gestiona novedades y el feed de Instagram desde un CMS basado en Git.</span>
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  .pick {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .pick__head {
    max-width: 760px;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .pick__head h1 {
    margin: 0.8rem 0 1.2rem;
  }
  .pick__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.4rem, 3vw, 2.2rem);
  }
  .pick__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .pick__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .pick__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .pick__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pick__card:hover .pick__media img {
    transform: scale(1.06);
  }
  .pick__num {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
  }
  .pick__body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.6vw, 1.9rem);
  }
  .pick__body h2 {
    font-size: 1.4rem;
  }
  .pick__body p {
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .pick__rasgos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pick__rasgos li {
    font-size: 0.74rem;
    padding: 0.3em 0.75em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  .pick__swatches {
    display: flex;
    gap: 0.4rem;
    margin: 0.2rem 0 0.6rem;
  }
  .pick__swatches span {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .pick__body .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .pick__extras {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .pick__extra {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.5rem 1.7rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .pick__extra:hover {
    border-color: var(--brand);
    background: var(--surface-2);
  }
  .pick__extra strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--brand);
  }
  .pick__extra span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .pick__grid {
      grid-template-columns: 1fr;
    }
    .pick__extras {
      grid-template-columns: 1fr;
    }
  }
</style>
