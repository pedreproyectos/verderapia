---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Slider from '../../components/Slider.astro';
import Historia from '../../components/Historia.astro';
import Pilares from '../../components/Pilares.astro';
import Terapias from '../../components/Terapias.astro';
import Yoga from '../../components/Yoga.astro';
import Talleres from '../../components/Talleres.astro';
import PostsSection from '../../components/PostsSection.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import GiftCard from '../../components/GiftCard.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { galeria } from '../../data/images';

const slides = galeria.hero.map((src, i) => ({
  src,
  alt: `Verderapia ${i + 1}`,
}));

const datos = [
  { valor: '04', label: 'Elementos', texto: 'agua · tierra · luz · aire' },
  { valor: '09', label: 'Terapias', texto: 'masajes, tarot y flores' },
  { valor: '03', label: 'Clases de yoga', texto: 'lunes, miércoles y sábado' },
];
---

<Base tema={3}>
  <SiteNav variant="glass" />

  <!-- HERO NOCHE VERDE -->
  <section class="nhero" aria-label="Bienvenida">
    <div class="nhero__slider">
      <Slider slides={slides} variant="stack" autoplay={6500} showCaptions={false} priority />
    </div>
    <div class="nhero__glow" aria-hidden="true"></div>
    <div class="nhero__overlay">
      <div class="container nhero__content">
        <p class="nhero__kicker">
          <span class="nhero__pulse"></span>
          {site.heroKicker}
        </p>
        <h1 class="nhero__title">
          Reencuentro y <span class="nhero__grad">conexión</span> con tus raíces
        </h1>
        <p class="nhero__text">{site.historia}</p>
        <div class="nhero__actions">
          <a class="btn" href={site.contacto.whatsappLink} target="_blank" rel="noopener noreferrer">Agenda tu terapia</a>
          <a class="btn btn--ghost nhero__ghost" href="#verde">Explorar la parcela</a>
        </div>
      </div>
    </div>
    <a class="nhero__scroll" href="#historia" aria-label="Bajar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </section>

  <!-- DATOS -->
  <section class="datos section--tight">
    <div class="container datos__grid">
      {datos.map((d, i) => (
        <article class="dato" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <strong>{d.valor}</strong>
          <h3>{d.label}</h3>
          <p>{d.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <Historia variant="centered" />
  <Pilares variant="cards" />
  <Terapias variant="cards" />
  <Yoga />
  <Talleres />
  <PostsSection />
  <InstagramFeed />
  <GiftCard />
  <Contacto />
  <Footer />
</Base>

<style>
  .nhero {
    position: relative;
    min-height: 100svh;
    display: grid;
    overflow: hidden;
  }
  .nhero__slider {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .nhero__slider :global(.slider) {
    border-radius: 0;
    height: 100%;
    filter: saturate(0.9) brightness(0.72);
  }
  .nhero__glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(50vw 50vw at 20% 85%, rgba(53, 224, 161, 0.35), transparent 65%),
      linear-gradient(180deg, rgba(11, 18, 15, 0.55) 0%, rgba(11, 18, 15, 0.35) 45%, rgba(11, 18, 15, 0.95) 100%);
  }
  .nhero__overlay {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
    padding-block: 9rem 5rem;
    pointer-events: none;
  }
  .nhero__content {
    max-width: 820px;
    color: var(--ink);
  }
  .nhero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.55em 1.1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .nhero__pulse {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--brand);
    box-shadow: 0 0 0 0 rgba(53, 224, 161, 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(53, 224, 161, 0.6); }
    70% { box-shadow: 0 0 0 12px rgba(53, 224, 161, 0); }
    100% { box-shadow: 0 0 0 0 rgba(53, 224, 161, 0); }
  }
  .nhero__title {
    margin: 1.4rem 0 1.2rem;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    line-height: 0.98;
  }
  .nhero__grad {
    background: linear-gradient(100deg, var(--brand) 10%, var(--accent) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nhero__text {
    max-width: 58ch;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    color: var(--ink-soft);
  }
  .nhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    pointer-events: auto;
  }
  .nhero__ghost {
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    border-color: var(--line);
    backdrop-filter: blur(10px);
    box-shadow: none;
  }
  .nhero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    transform: translateX(-50%);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--brand);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    animation: bob 2.4s ease-in-out infinite;
  }
  .nhero__scroll svg {
    width: 20px;
    height: 20px;
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  /* Datos */
  .datos {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .datos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }
  .dato {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    backdrop-filter: blur(12px);
  }
  .dato strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    background: linear-gradient(120deg, var(--brand), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .dato h3 {
    margin: 0.6rem 0 0.2rem;
    font-size: 1.05rem;
  }
  .dato p {
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .datos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
