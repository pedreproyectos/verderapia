---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Slider from '../../components/Slider.astro';
import Historia from '../../components/Historia.astro';
import Pilares from '../../components/Pilares.astro';
import Terapias from '../../components/Terapias.astro';
import Yoga from '../../components/Yoga.astro';
import Talleres from '../../components/Talleres.astro';
import PostsSection from '../../components/PostsSection.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import GiftCard from '../../components/GiftCard.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { galeria } from '../../data/images';
import { getCtas } from '../../data/ctas';

const slides = galeria.hero.map((src, i) => ({
  src,
  alt: `Verderapia — parcela sustentable ${i + 1}`,
}));

const ctas = await getCtas();
const mainCta = ctas[0];
const secondaryCtas = ctas.slice(1);
---

<Base tema={1}>
  <SiteNav variant="transparent" />

  <!-- HERO -->
  <section class="hero" aria-label="Bienvenida">
    <div class="hero__slider">
      <Slider slides={slides} variant="kenburns" autoplay={7000} showCaptions={false} priority />
    </div>
    <div class="hero__overlay">
      <div class="container hero__content">
        <p class="hero__kicker">{site.heroKicker}</p>
        <h1 class="hero__title">{site.heroTitulo}</h1>
        <div class="hero__actions">
          {mainCta && (
            <a
              class="btn"
              href={mainCta.href}
              target={mainCta.external ? '_blank' : undefined}
              rel={mainCta.external ? 'noopener noreferrer' : undefined}
            >
              {mainCta.label}
            </a>
          )}
          {secondaryCtas.map((cta) => (
            <a
              class="btn hero__ghost"
              href={cta.href}
              target={cta.external ? '_blank' : undefined}
              rel={cta.external ? 'noopener noreferrer' : undefined}
            >
              {cta.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HISTORIA -->
  <Historia variant="split" />

  <!-- PILARES -->
  <Pilares variant="rows" />

  <!-- TERAPIAS -->
  <Terapias variant="list" />

  <!-- YOGA -->
  <Yoga />

  <!-- TALLERES -->
  <Talleres />

  <!-- NOVEDADES -->
  <PostsSection />

  <!-- INSTAGRAM -->
  <InstagramFeed />

  <!-- GIFT CARD / DESCUENTOS -->
  <GiftCard />

  <!-- CONTACTO -->
  <Contacto />

  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
  }
  .hero__slider {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__slider :global(.slider) {
    height: 100%;
    border-radius: 0;
  }
  .hero__overlay {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    align-self: stretch;
    width: 100%;
    min-height: 100%;
    padding-top: clamp(9rem, 22vh, 16rem);
    padding-bottom: clamp(1.6rem, 3.5vh, 2.8rem);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(20, 34, 24, 0.5) 0%,
      rgba(20, 34, 24, 0.08) 30%,
      rgba(20, 34, 24, 0.06) 48%,
      rgba(20, 34, 24, 0.62) 80%,
      rgba(20, 34, 24, 0.9) 100%
    );
  }
  .hero__content {
    max-width: 940px;
    color: #fff;
  }
  .hero__kicker {
    display: inline-block;
    padding: 0.5em 1.1em;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
  }
  .hero__title {
    margin: 1.2rem 0 1rem;
    font-size: clamp(2.4rem, 5.2vw, 4.3rem);
    line-height: 1.02;
    text-wrap: balance;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.35);
  }
  /* El CTA vive en su propia fila al pie del hero, para tapar lo mínimo de la imagen */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: clamp(1.2rem, 3vh, 2.2rem);
    pointer-events: auto;
  }
  .hero__ghost {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
    box-shadow: none;
  }
  .hero__ghost:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .hero :global(.slider__dots) {
    left: auto;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vh, 2.4rem);
    transform: none;
  }
  @media (max-width: 900px) {
    .hero__overlay {
      padding-top: clamp(7rem, 18vh, 10rem);
      padding-bottom: clamp(2.2rem, 5vh, 3rem);
    }
    .hero__title {
      font-size: clamp(2.1rem, 8.5vw, 3rem);
    }
    .hero :global(.slider__dots) {
      left: auto;
      right: 1.2rem;
      top: 5.4rem;
      bottom: auto;
      transform: none;
    }
  }

  /* Fondos alternados para dar ritmo visual */
  :global([data-tema='1'] #terapias),
  :global([data-tema='1'] #instagram) {
    background: var(--bg-2);
  }
  :global([data-tema='1'] #giftcard) {
    background: var(--bg);
  }
</style>
