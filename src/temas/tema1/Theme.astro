---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Slider from '../../components/Slider.astro';
import Historia from '../../components/Historia.astro';
import Pilares from '../../components/Pilares.astro';
import Terapias from '../../components/Terapias.astro';
import Yoga from '../../components/Yoga.astro';
import Talleres from '../../components/Talleres.astro';
import PostsSection from '../../components/PostsSection.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import GiftCard from '../../components/GiftCard.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { galeria } from '../../data/images';

const slides = galeria.hero.map((src, i) => ({
  src,
  alt: `Verderapia — parcela sustentable ${i + 1}`,
}));
---

<Base tema={1}>
  <SiteNav variant="solid" />

  <!-- HERO -->
  <section class="hero" aria-label="Bienvenida">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="hero__kicker">{site.heroKicker}</p>
        <h1 class="hero__title">{site.heroTitulo}</h1>
        <p class="hero__text">{site.historia}</p>
        <div class="hero__actions">
          <a class="btn" href={site.contacto.whatsappLink} target="_blank" rel="noopener noreferrer">Agenda tu terapia</a>
          <a class="btn hero__ghost" href="#verde">Conoce la parcela</a>
        </div>
      </div>
      <div class="hero__media">
        <Slider slides={slides} variant="kenburns" autoplay={7000} showCaptions={false} priority />
      </div>
    </div>
  </section>

  <!-- HISTORIA -->
  <Historia variant="split" />

  <!-- PILARES -->
  <Pilares variant="rows" />

  <!-- TERAPIAS -->
  <Terapias variant="list" />

  <!-- YOGA -->
  <Yoga />

  <!-- TALLERES -->
  <Talleres />

  <!-- NOVEDADES -->
  <PostsSection />

  <!-- INSTAGRAM -->
  <InstagramFeed />

  <!-- GIFT CARD / DESCUENTOS -->
  <GiftCard />

  <!-- CONTACTO -->
  <Contacto />

  <Footer />
</Base>

<style>
  .hero {
    padding-top: clamp(7rem, 11vw, 9rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__content {
    max-width: 600px;
  }
  .hero__kicker {
    display: inline-block;
    padding: 0.5em 1.1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--brand);
    background: var(--surface);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .hero__title {
    margin: 1.4rem 0 1.2rem;
    font-size: clamp(2.6rem, 5.6vw, 4.9rem);
    line-height: 0.98;
    color: var(--ink);
  }
  .hero__text {
    max-width: 52ch;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    color: var(--ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero__ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
    box-shadow: none;
  }
  .hero__ghost:hover {
    background: var(--surface-2);
  }
  .hero__media {
    position: relative;
  }
  .hero__media :global(.slider) {
    aspect-ratio: 4 / 5;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 3rem);
    }
    .hero__media :global(.slider) {
      aspect-ratio: 4 / 3;
    }
  }

  /* Fondos alternados para dar ritmo visual */
  :global([data-tema='1'] #terapias),
  :global([data-tema='1'] #instagram) {
    background: var(--bg-2);
  }
  :global([data-tema='1'] #giftcard) {
    background: var(--bg);
  }
</style>
