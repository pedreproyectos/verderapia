---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Slider from '../../components/Slider.astro';
import Historia from '../../components/Historia.astro';
import Pilares from '../../components/Pilares.astro';
import Terapias from '../../components/Terapias.astro';
import Servicios from '../../components/Servicios.astro';
import PostsSection from '../../components/PostsSection.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import GiftCard from '../../components/GiftCard.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/Footer.astro';
import { galeria } from '../../data/images';
import { getHeroSlides } from '../../data/slides';
import { getCtas } from '../../data/ctas';

// Las diapositivas del hero se administran desde Keystatic (/keystatic).
// Si aún no hay ninguna, se usa el catálogo por defecto como respaldo.
const heroSlides = await getHeroSlides();
const slides = heroSlides.length
  ? heroSlides.map((slide) => ({
      src: slide.image,
      alt: slide.alt,
      eyebrow: slide.eyebrow,
      title: slide.title,
      text: slide.text,
    }))
  : galeria.hero.map((src, i) => ({
      src,
      alt: `Verderapia — parcela sustentable ${i + 1}`,
    }));

const ctas = await getCtas();
const mainCta = ctas[0];
const secondaryCtas = ctas.slice(1);

// Muestra el ícono de WhatsApp cuando el enlace es un chat de WhatsApp.
const isWhatsApp = (href: string) => /wa\.me|whatsapp/i.test(href);
---

<Base tema={1}>
  <SiteNav variant="transparent" />

  <!-- HERO -->
  <section class="hero" aria-label="Bienvenida">
    <div class="hero__slider">
      <Slider slides={slides} variant="kenburns" autoplay={7000} showCaptions priority />
    </div>
    <div class="hero__overlay">
      <div class="hero__actions">
        {mainCta && (
          <a
            class="btn"
            href={mainCta.href}
            target={mainCta.external ? '_blank' : undefined}
            rel={mainCta.external ? 'noopener noreferrer' : undefined}
          >
            {isWhatsApp(mainCta.href) && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 0 1 6.9 12.6l-.3.5.8 2.9-3-.8-.5.3A8.2 8.2 0 1 1 12 3.8Zm-3 4c-.2 0-.5.1-.7.4-.3.3-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.2-.1-1-.4-1.8-1.1-.7-.6-1.1-1.3-1.2-1.5-.1-.2 0-.3.1-.4l.4-.4c.1-.2.1-.3.2-.5 0-.2 0-.3-.1-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5Z"/></svg>
            )}
            {mainCta.label}
          </a>
        )}
        {secondaryCtas.map((cta) => (
          <a
            class="btn hero__ghost"
            href={cta.href}
            target={cta.external ? '_blank' : undefined}
            rel={cta.external ? 'noopener noreferrer' : undefined}
          >
            {isWhatsApp(cta.href) && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 0 1 6.9 12.6l-.3.5.8 2.9-3-.8-.5.3A8.2 8.2 0 1 1 12 3.8Zm-3 4c-.2 0-.5.1-.7.4-.3.3-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.2-.1-1-.4-1.8-1.1-.7-.6-1.1-1.3-1.2-1.5-.1-.2 0-.3.1-.4l.4-.4c.1-.2.1-.3.2-.5 0-.2 0-.3-.1-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5Z"/></svg>
            )}
            {cta.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HISTORIA -->
  <Historia variant="split" />

  <!-- PILARES -->
  <Pilares variant="rows" />

  <!-- TERAPIAS -->
  <Terapias variant="list" />

  <!-- SERVICIOS -->
  <Servicios />

  <!-- NOVEDADES -->
  <PostsSection />

  <!-- INSTAGRAM -->
  <InstagramFeed />

  <!-- GIFT CARD / DESCUENTOS -->
  <GiftCard />

  <!-- CONTACTO -->
  <Contacto />

  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    /* Espacio reservado abajo para los CTA, por encima de los cuales flota
       el texto de cada diapositiva. */
    --hero-cta-space: clamp(6.5rem, 14vh, 9rem);
  }
  .hero__slider {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__slider :global(.slider) {
    height: 100%;
    border-radius: 0;
  }
  .hero__overlay {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    align-self: stretch;
    width: 100%;
    min-height: 100%;
    padding-top: clamp(9rem, 22vh, 16rem);
    padding-bottom: clamp(1.6rem, 3.5vh, 2.8rem);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(20, 34, 24, 0.5) 0%,
      rgba(20, 34, 24, 0.08) 30%,
      rgba(20, 34, 24, 0.06) 48%,
      rgba(20, 34, 24, 0.62) 80%,
      rgba(20, 34, 24, 0.9) 100%
    );
  }
  /* El texto de cada diapositiva se muestra justo encima de los CTA, dentro de
     una caja de vidrio esmerilado para mantener la legibilidad. */
  .hero :global(.slider__caption) {
    bottom: var(--hero-cta-space);
    left: clamp(1rem, 4vw, 3rem);
    right: auto;
    width: fit-content;
    max-width: min(640px, 90%);
    padding: clamp(1rem, 2.4vw, 1.5rem) clamp(1.2rem, 3vw, 1.8rem);
    background: rgba(18, 30, 22, 0.45);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
  }
  /* El CTA vive en su propia fila al pie del hero, alineado a la izquierda
     igual que el texto de la diapositiva. */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-left: clamp(1rem, 4vw, 3rem);
    pointer-events: auto;
  }
  .hero__ghost {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
    box-shadow: none;
  }
  .hero__ghost:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .hero :global(.slider__dots) {
    left: auto;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vh, 2.4rem);
    transform: none;
  }
  @media (max-width: 900px) {
    .hero__overlay {
      padding-top: clamp(7rem, 18vh, 10rem);
      padding-bottom: clamp(2.2rem, 5vh, 3rem);
    }
    .hero :global(.slider__dots) {
      left: auto;
      right: 1.2rem;
      top: 5.4rem;
      bottom: auto;
      transform: none;
    }
  }

  /* Fondos alternados para dar ritmo visual */
  :global([data-tema='1'] #terapias),
  :global([data-tema='1'] #instagram) {
    background: var(--bg-2);
  }
  :global([data-tema='1'] #giftcard) {
    background: var(--bg);
  }
</style>
