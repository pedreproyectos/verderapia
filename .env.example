# Keystatic en producción (GitHub)
# Copia estos valores en Cloudflare → Settings → Variables and Secrets.
KEYSTATIC_STORAGE=github
KEYSTATIC_REPO=pedreproyectos/verderapia
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Feed de Instagram vía Behold (recomendado, sin app de Meta)
# Variables de BUILD: el feed se obtiene durante el build.
INSTAGRAM_FEED_URL=https://feeds.behold.so/BelomHkOxBzyPiKgbxV8

# Alternativa: Instagram Graph API (requiere app de Meta)
# Variables de BUILD: el feed se obtiene durante el build.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ---------------------------------------------------------------------------
# Paywall de cursos (pagos, acceso y correo)
# ---------------------------------------------------------------------------
# Modo: "demo" NO debe usarse en producción (otorga acceso sin cobro).
PAYMENTS_MODE=

# Panel /admin/ordenes (usuario "admin")
ADMIN_TOKEN=

# Flow
FLOW_API_KEY=
FLOW_SECRET=
FLOW_SANDBOX=

# Correo transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM=cursos@verderapia.cl

PUBLIC_SITE_URL=https://verderapia.cl
