# Keystatic en producción (GitHub)
# Copia estos valores en Cloudflare → Settings → Variables and Secrets.
KEYSTATIC_STORAGE=github
KEYSTATIC_REPO=pedreproyectos/verderapia
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Feed de Instagram vía Behold (recomendado, sin app de Meta)
# Variables de BUILD: el feed se obtiene durante el build.
INSTAGRAM_FEED_URL=

# Alternativa: Instagram Graph API (requiere app de Meta)
# Variables de BUILD: el feed se obtiene durante el build.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
