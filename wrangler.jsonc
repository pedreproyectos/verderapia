{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verde",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  // Adaptador de Cloudflare: worker para las rutas de Keystatic y el sitio.
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Archivos estáticos generados por `astro build`.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
