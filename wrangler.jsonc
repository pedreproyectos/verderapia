{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verderapia",
  // Dominio personalizado. Requiere que verderapia.cl esté activo como zona
  // en la misma cuenta de Cloudflare. Cloudflare gestiona DNS y certificado.
  "routes": [
    { "pattern": "verderapia.cl", "custom_domain": true },
    { "pattern": "www.verderapia.cl", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  // Adaptador de Cloudflare: worker para las rutas de Keystatic y el sitio.
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Archivos estáticos generados por `astro build`.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
